# ===================================================================
# .env.dev.example — Template ไฟล์คอนฟิกสำหรับ Bear Cafe Dev Bot บน SSH
# คัดลอกไฟล์นี้ไปเป็น .env ในโฟลเดอร์ bearcafe-dev
# ===================================================================

NODE_ENV=development
DEV_MODE=true
PORT=8001

# --- Discord Bot Tokens ---
# BOT_TOKEN ของตัว Dev หรือกำหนด SECONDARY_BOT_TOKEN / DISCORD_HEALJAI_TOKEN
BOT_TOKEN="ใส่_DEV_BOT_TOKEN_ที่นี่"
SECONDARY_BOT_TOKEN="ใส่_DEV_BOT_TOKEN_ที่นี่"
DISCORD_HEALJAI_TOKEN="ใส่_DEV_BOT_TOKEN_ที่นี่"

# --- Database & Storage (Supabase) ---
SUPABASE_URL="https://orbxyyjpvpbqwfssnyeq.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ใส่_SUPABASE_SERVICE_ROLE_KEY_ที่นี่"

# --- Redis Cache (Upstash) ---
UPSTASH_REDIS_REST_URL="https://novel-filly-87074.upstash.io"
UPSTASH_REDIS_REST_TOKEN="ใส่_UPSTASH_REDIS_TOKEN_ที่นี่"

# --- Server IDs & Testing Scope ---
GUILD_ID="1144251788493602848"
HEALJAI_GUILD_ID="1536199707922141254"
HEALJAI_TRANSCRIPTS_CHANNEL_ID="1545240025111990423"

# --- Isolation Flags: ป้องกัน Dev ทำงานทับซ้อนกับ Production (สำคัญมาก) ---
DISABLE_DM_BROADCAST=true        # ปิดคิวส่ง DM บรอดแคสต์ (ไม่ให้ส่งซ้ำกับ Prod)
DISABLE_CONTRACT_NOTIFIER=true   # ปิดตัวสแกนสัญญาเพื่อส่ง DM
DISABLE_BROADCAST_SCHEDULER=true # ปิดตัวส่งประกาศอัตโนมัติ
DISABLE_VOICE_WORKER=true        # ปิดตัวดูด Redis Voice Log (ป้องกันการแย่งคิว Prod)

# --- Dev Scope Permissions ---
# กำหนดห้องที่อนุญาตให้บอท Dev ตอบสนองคำสั่ง
DEV_CHANNEL_IDS="1524123372210880664,1544088196332134491,1545239851958538270,1536206516359532665,1536199708593365084,1545240537089703986,1545240025111990423"

# ฟีเจอร์ที่เปิดใช้งานใน Dev
DEV_FEATURES="healJai,gachapon,sendComponent,stickyPanels,bearCafeActivitySync"

# คำสั่ง Slash ที่อนุญาตให้ลงทะเบียนใน Dev
DEV_SLASH_COMMANDS="send-component,heal-component,ยืนยันการโอน,บัตรพนักงาน,healjai-admin,อนุมัติสลิป,หมุนกาชา,แก้ไขพนักงาน"
